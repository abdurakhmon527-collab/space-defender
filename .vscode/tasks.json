{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure SPACE SURVIVOR",
      "type": "shell",
      "command": "cmake -S . -B build -G \"MinGW Makefiles\" -DCMAKE_BUILD_TYPE=Release",
      "problemMatcher": []
    },
    {
      "label": "Build SPACE SURVIVOR",
      "type": "shell",
      "command": "cmake --build build --parallel",
      "dependsOn": "Configure SPACE SURVIVOR",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test SPACE SURVIVOR",
      "type": "shell",
      "command": "ctest --test-dir build --output-on-failure",
      "dependsOn": "Build SPACE SURVIVOR",
      "problemMatcher": []
    },
    {
      "label": "Run SPACE SURVIVOR",
      "type": "shell",
      "command": ".\\build\\SPACE_SURVIVOR.exe",
      "dependsOn": "Build SPACE SURVIVOR",
      "problemMatcher": []
    }
  ]
}
